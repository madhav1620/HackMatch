# ── Server ─────────────────────────────────────────────
PORT=4000
CLIENT_URL=http://localhost:5173

# ── Database (Phase 2) ─────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/hackmatch?schema=public"
# Local dev alternative: SQLITE via Prisma provider switch

# ── Auth (Phase 2) ─────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Comma-separated allowed college email domains
COLLEGE_DOMAINS=edu,ac.in,edu.in

# ── OTP Email (Phase 2) ────────────────────────────────
# Leave SMTP_* empty to log OTP codes to the dev console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HackMatch <no-reply@hackmatch.dev>"
