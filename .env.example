# ── Server ─────────────────────────────────────────────
PORT=4000
CLIENT_URL=http://localhost:5173

# Deployment (Phase 5)
# NODE_ENV=production makes Express serve the built client (client/dist) from
# this same server, so the app is single-origin — the client calls the API with
# relative /api/* paths and needs no CORS or API-base config.
# NODE_ENV=production
# SERVE_CLIENT=true

# ── Database ────────────────────────────────────────────
# Postgres is used for both dev and prod (native String[] columns for
# skills / techTags / requiredRoles / requiredSkills).
# Local dev: any Postgres you can reach — a local install, Docker, or a
# hosted instance. Render/Railway inject DATABASE_URL automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackmatch?schema=public"

# ── Auth (Phase 2) ─────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Comma-separated allowed college email domains
COLLEGE_DOMAINS=edu,ac.in,edu.in

# ── OTP Email (Phase 2) ────────────────────────────────
# Leave SMTP_* empty to log OTP codes to the dev console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HackMatch <no-reply@hackmatch.dev>"
