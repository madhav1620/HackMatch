// HackMatch Prisma schema — see ARCHITECTURE.md §3
// Postgres everywhere (dev + prod): skill/role/tag lists are native String[].
// JSON-string columns were a SQLite workaround and are gone (see git history).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums (SQLite stores as string; validated in Zod + services) ──────────────
// UserRole:       STUDENT | ORGANIZER | ADMIN
// PrimaryRole:    FRONTEND | BACKEND | AIML | UIUX | PITCH | DEVOPS | DATA | OTHER
// Mode:           ONLINE | OFFLINE | HYBRID
// OrgType:        INTERNAL | EXTERNAL
// HackathonStatus: DRAFT | PUBLISHED | CLOSED
// Availability:   AVAILABLE | BUSY | UNAVAILABLE
// TeamChannel:    DISCORD | WHATSAPP | EMAIL
// RequestType:    JOIN | INVITE
// RequestStatus:  PENDING | ACCEPTED | DECLINED | CANCELLED

model User {
  id           String  @id @default(cuid())
  email        String  @unique // college email (domain-verified at register)
  passwordHash String
  name         String
  avatarUrl   String?
  verified    Boolean @default(false)
  role        String  @default("STUDENT") // STUDENT | ORGANIZER | ADMIN

  // onboarding profile
  primaryRole   String  @default("OTHER") // PrimaryRole
  bio           String?
  skills        String[] @default([])
  githubUrl     String?
  linkedinUrl   String?
  portfolioUrl  String?
  discordHandle String?
  whatsappNo    String?
  availability  String  @default("AVAILABLE") // Availability

  // OTP
  otpCode      String?
  otpExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams        TeamMember[]
  teamsCreated Team[]
  requestsSent JoinRequest[]
  hackathons   Hackathon[]    @relation("postedBy")
  bookmarks    Bookmark[]
  soloPosts    SoloPost[]
}

model Hackathon {
  id                   String  @id @default(cuid())
  name                 String
  tagline              String?
  description          String
  logoUrl             String?
  url                  String? // external registration link
  mode                 String  @default("ONLINE") // Mode
  location             String? // venue/city when OFFLINE/HYBRID
  orgType              String  @default("EXTERNAL") // OrgType
  prizePool            Int     @default(0) // INR
  registrationDeadline DateTime
  startDate            DateTime
  endDate              DateTime
  techTags             String[] @default([])
  minTeamSize          Int     @default(1)
  maxTeamSize          Int     @default(6)
  status               String  @default("PUBLISHED") // HackathonStatus

  organizerId String?
  organizer   User?   @relation("postedBy", fields: [organizerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams      Team[]
  bookmarks  Bookmark[]
  soloPosts  SoloPost[]

  @@index([registrationDeadline])
  @@index([mode])
}

model Team {
  id             String  @id @default(cuid())
  hackathonId    String
  hackathon      Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  name           String
  description    String
  track          String? // e.g. "Applied AI · Bio-Sensing Track"
  isRecruiting   Boolean @default(true)
  openSlots      Int     @default(1)
  requiredRoles  String[] @default([])
  requiredSkills String[] @default([])
  contactChannel String  @default("DISCORD") // TeamChannel
  contactValue   String?

  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      TeamMember[]
  joinRequests JoinRequest[]

  @@index([hackathonId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   // PrimaryRole — member's role inside this team
  isLeader Boolean  @default(false)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model JoinRequest {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User     @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  type        String   @default("JOIN") // RequestType
  message     String?
  role        String? // PrimaryRole the applicant is pitching for
  portfolioUrl String?
  commitment  String? // FULL_36H | PARTIAL | FLEXIBLE
  status      String   @default("PENDING") // RequestStatus
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([teamId, requesterId])
  @@index([requesterId])
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  remindAt    DateTime?
  createdAt   DateTime @default(now())

  @@unique([userId, hackathonId])
}

model SoloPost {
  id          String   @id @default(cuid())
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pitch       String
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([hackathonId, userId])
  @@index([hackathonId])
}
